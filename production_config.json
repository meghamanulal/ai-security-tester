{
  "production": {
    "mode": "production",
    "debug": false,
    "api": {
      "main_platform": {
        "host": "0.0.0.0",
        "port": 8000,
        "workers": 4
      },
      "ai_orchestrator": {
        "host": "0.0.0.0",
        "port": 8001,
        "workers": 2
      }
    },
    "frontend": {
      "host": "localhost",
      "port": 3000,
      "build_mode": "production"
    },
    "security": {
      "enable_cors": true,
      "cors_origins": [
        "http://localhost:3000"
      ],
      "enable_rate_limiting": true,
      "max_requests_per_minute": 60
    },
    "scanning": {
      "max_concurrent_scans": 5,
      "scan_timeout": 300,
      "enable_real_scanning": true,
      "allowed_targets": [
        "domains",
        "ips",
        "localhost"
      ]
    },
    "logging": {
      "level": "INFO",
      "file": "logs/production.log",
      "max_size": "10MB",
      "backup_count": 5
    }
  }
}